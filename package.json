{
  "name": "minesweeper-clone",
  "version": "2.0.0-alpha.5",
  "description": "A clone of Minesweeper made using JavaScript and rendered with PixiJS.",
  "main": "client/game.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite serve",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint .",
    "format": "prettier --config ./.prettierrc --write .",
    "format:check": "prettier --config ./.prettierrc --check .",
    "type-check": "tsc",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test-ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci",
    "cypress": "cypress",
    "cypress:run": "cypress run --spec 'cypress/e2e/**/*.cy.ts' --browser chrome"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coteh/MinesweeperClone.git"
  },
  "author": "James Cote",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "feather-icons": "^4.29.2",
    "pixi.js": "8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/feather-icons": "^4.29.4",
    "@types/howler": "^2.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "csstype": "^3.1.3",
    "cypress": "^15.10.0",
    "cypress-real-events": "^1.13.0",
    "cypress-wait-until": "^1.7.2",
    "eslint": "^9.39.2",
    "howler": "^2.2.4",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "marked": "^17.0.1",
    "mobile-detect": "^1.4.5",
    "pixi-filters": "6.1.0",
    "prettier": "3.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.4.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
